# 로컬 CMS 테스트: 반드시 `netlify dev`로 실행합니다.
CMS_STORAGE_MODE=local

# GitHub에 게시/반영할 때 사용합니다.
GITHUB_TOKEN=
GITHUB_OWNER=team-ifcommunity
GITHUB_REPO=if-tech-blog
GITHUB_BRANCH=main
GITHUB_ASSETS_OWNER=team-ifcommunity
GITHUB_ASSETS_REPO=if-tech-blog-assets
GITHUB_ASSETS_BRANCH=main

# 선택 사항: GitHub 반영 후 별도 Build Hook도 호출할 때만 설정합니다.
NETLIFY_BUILD_HOOK_URL=

# 배포된 assets 저장소/CDN 주소
PUBLIC_ASSETS_BASE_URL=
