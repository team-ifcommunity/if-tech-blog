<div class="wysiwyg" data-wysiwyg>
	<div class="wysiwyg__toolbar" role="toolbar" aria-label="본문 서식 도구">
		<div class="wysiwyg__toolbar-group" aria-label="글자 서식">
			<button type="button" data-editor-action="bold" title="굵게 (Ctrl+B)" aria-label="굵게">
				<strong>B</strong>
			</button>
			<button type="button" data-editor-action="italic" title="기울임 (Ctrl+I)" aria-label="기울임">
				<em>I</em>
			</button>
			<button type="button" data-editor-action="code" title="인라인 코드" aria-label="인라인 코드">
				&lt;/&gt;
			</button>
		</div>
		<div class="wysiwyg__toolbar-group" aria-label="제목과 목록">
			<button type="button" data-editor-action="heading2" title="큰 소제목" aria-label="큰 소제목"
				>H2</button
			>
			<button
				type="button"
				data-editor-action="heading3"
				title="작은 소제목"
				aria-label="작은 소제목">H3</button
			>
			<button
				type="button"
				data-editor-action="bulletList"
				title="글머리 기호 목록"
				aria-label="글머리 기호 목록">• 목록</button
			>
			<button
				type="button"
				data-editor-action="orderedList"
				title="번호 목록"
				aria-label="번호 목록">1. 목록</button
			>
		</div>
		<div class="wysiwyg__toolbar-group" aria-label="블록과 링크">
			<button type="button" data-editor-action="blockquote" title="인용문" aria-label="인용문"
				>“ 인용</button
			>
			<button type="button" data-editor-action="codeBlock" title="코드 블록" aria-label="코드 블록"
				>코드 블록</button
			>
			<button type="button" data-editor-action="link" title="링크" aria-label="링크">🔗 링크</button
			>
		</div>
		<div
			class="wysiwyg__toolbar-group wysiwyg__toolbar-group--history"
			aria-label="실행 취소와 다시 실행"
		>
			<button
				type="button"
				data-editor-action="undo"
				title="실행 취소 (Ctrl+Z)"
				aria-label="실행 취소">↶</button
			>
			<button
				type="button"
				data-editor-action="redo"
				title="다시 실행 (Ctrl+Shift+Z)"
				aria-label="다시 실행">↷</button
			>
		</div>
	</div>
	<div class="wysiwyg__content" data-editor-content></div>
	<input type="hidden" name="content" data-editor-value />
</div>

<script>
	import { Editor } from '@tiptap/core';
	import Placeholder from '@tiptap/extension-placeholder';
	import StarterKit from '@tiptap/starter-kit';
	import { serializeTiptapToMarkdown } from '@/utils/tiptapMarkdown.mjs';

	type EditorAction =
		| 'bold'
		| 'italic'
		| 'code'
		| 'heading2'
		| 'heading3'
		| 'bulletList'
		| 'orderedList'
		| 'blockquote'
		| 'codeBlock'
		| 'link'
		| 'undo'
		| 'redo';

	document.querySelectorAll<HTMLElement>('[data-wysiwyg]').forEach((root) => {
		const content = root.querySelector<HTMLElement>('[data-editor-content]');
		const value = root.querySelector<HTMLInputElement>('[data-editor-value]');
		const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-editor-action]'));

		if (!content || !value) return;

		const editor = new Editor({
			element: content,
			extensions: [
				StarterKit.configure({
					heading: { levels: [2, 3] },
					horizontalRule: false,
					link: {
						autolink: true,
						linkOnPaste: true,
						openOnClick: false,
						HTMLAttributes: {
							rel: 'noopener noreferrer',
							target: '_blank'
						}
					},
					strike: false,
					underline: false
				}),
				Placeholder.configure({ placeholder: '내용을 입력하세요.' })
			],
			content: '<p></p>',
			editorProps: {
				attributes: {
					'aria-label': '글 내용',
					class: 'tiptap-editor',
					spellcheck: 'true'
				}
			},
		});

		editor.on('update', ({ editor }) => syncValue(editor));
		editor.on('selectionUpdate', ({ editor }) => updateToolbar(editor));
		editor.on('transaction', ({ editor }) => updateToolbar(editor));
		syncValue(editor);
		updateToolbar(editor);

		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				const action = button.dataset.editorAction as EditorAction;

				switch (action) {
					case 'bold':
						editor.chain().focus().toggleBold().run();
						break;
					case 'italic':
						editor.chain().focus().toggleItalic().run();
						break;
					case 'code':
						editor.chain().focus().toggleCode().run();
						break;
					case 'heading2':
						editor.chain().focus().toggleHeading({ level: 2 }).run();
						break;
					case 'heading3':
						editor.chain().focus().toggleHeading({ level: 3 }).run();
						break;
					case 'bulletList':
						editor.chain().focus().toggleBulletList().run();
						break;
					case 'orderedList':
						editor.chain().focus().toggleOrderedList().run();
						break;
					case 'blockquote':
						editor.chain().focus().toggleBlockquote().run();
						break;
					case 'codeBlock':
						editor.chain().focus().toggleCodeBlock().run();
						break;
					case 'link': {
						const currentUrl = editor.getAttributes('link').href ?? '';
						const url = window.prompt('연결할 주소를 입력해 주세요.', currentUrl);
						if (url === null) break;
						if (!url.trim()) editor.chain().focus().extendMarkRange('link').unsetLink().run();
						else editor.chain().focus().extendMarkRange('link').setLink({ href: url.trim() }).run();
						break;
					}
					case 'undo':
						editor.chain().focus().undo().run();
						break;
					case 'redo':
						editor.chain().focus().redo().run();
						break;
				}
			});
		});

		root.closest('form')?.addEventListener('reset', () => {
			window.setTimeout(() => editor.commands.clearContent(), 0);
		});

		function syncValue(currentEditor: Editor) {
			const markdown = currentEditor.getText().trim()
				? serializeTiptapToMarkdown(currentEditor.state.doc)
				: '';
			value.value = markdown;
		}

		function updateToolbar(currentEditor: Editor) {
			const activeActions: Partial<Record<EditorAction, boolean>> = {
				bold: currentEditor.isActive('bold'),
				italic: currentEditor.isActive('italic'),
				code: currentEditor.isActive('code'),
				heading2: currentEditor.isActive('heading', { level: 2 }),
				heading3: currentEditor.isActive('heading', { level: 3 }),
				bulletList: currentEditor.isActive('bulletList'),
				orderedList: currentEditor.isActive('orderedList'),
				blockquote: currentEditor.isActive('blockquote'),
				codeBlock: currentEditor.isActive('codeBlock'),
				link: currentEditor.isActive('link')
			};

			buttons.forEach((button) => {
				const action = button.dataset.editorAction as EditorAction;
				const isActive = activeActions[action] ?? false;
				button.classList.toggle('is-active', isActive);
				if (action !== 'undo' && action !== 'redo')
					button.setAttribute('aria-pressed', String(isActive));
				if (action === 'undo') button.disabled = !currentEditor.can().chain().focus().undo().run();
				if (action === 'redo') button.disabled = !currentEditor.can().chain().focus().redo().run();
			});
		}
	});
</script>

<style>
	.wysiwyg {
		border: 1px solid #d9dce1;
		border-radius: 9px;
		overflow: hidden;
		background: white;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.wysiwyg:focus-within {
		border-color: var(--primary1);
		box-shadow: 0 0 0 3px rgba(229, 45, 66, 0.12);
	}

	.wysiwyg__toolbar {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 9px;
		border-bottom: 1px solid #e7e7e7;
		background: #f7f8f9;
		flex-wrap: wrap;
	}

	.wysiwyg__toolbar-group {
		display: flex;
		gap: 3px;
		padding-right: 6px;
		border-right: 1px solid #dfe1e4;
	}

	.wysiwyg__toolbar-group--history {
		margin-left: auto;
		padding-right: 0;
		border-right: 0;
	}

	.wysiwyg__toolbar button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 34px;
		height: 34px;
		padding: 0 9px;
		border: 1px solid transparent;
		border-radius: 6px;
		background: transparent;
		font: inherit;
		font-size: 0.8125rem;
		font-weight: 650;
		color: #4b5057;
		cursor: pointer;
	}

	.wysiwyg__toolbar button:hover:not(:disabled) {
		border-color: #d9dce1;
		background: white;
	}

	.wysiwyg__toolbar button.is-active {
		border-color: rgba(229, 45, 66, 0.25);
		background: rgba(229, 45, 66, 0.1);
		color: var(--primary1);
	}

	.wysiwyg__toolbar button:focus-visible {
		outline: 2px solid var(--primary1);
		outline-offset: 1px;
	}

	.wysiwyg__toolbar button:disabled {
		opacity: 0.35;
		cursor: default;
	}

	.wysiwyg__content :global(.tiptap) {
		min-height: 420px;
		padding: 20px;
		font-size: 1rem;
		line-height: 1.8;
		color: var(--c333);
	}

	.wysiwyg__content :global(.tiptap:focus) {
		outline: none;
	}

	.wysiwyg__content :global(.tiptap > * + *) {
		margin-top: 0.9em;
	}

	.wysiwyg__content :global(.tiptap h2) {
		font-size: 1.625rem;
		font-weight: 700;
		line-height: 1.4;
	}

	.wysiwyg__content :global(.tiptap h3) {
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.5;
	}

	.wysiwyg__content :global(.tiptap ul),
	.wysiwyg__content :global(.tiptap ol) {
		padding-left: 1.6em;
	}

	.wysiwyg__content :global(.tiptap ul) {
		list-style: disc;
	}

	.wysiwyg__content :global(.tiptap ol) {
		list-style: decimal;
	}

	.wysiwyg__content :global(.tiptap blockquote) {
		padding: 8px 0 8px 16px;
		border-left: 3px solid #d9dce1;
		color: #626871;
	}

	.wysiwyg__content :global(.tiptap code) {
		padding: 2px 5px;
		border-radius: 4px;
		background: #f0f1f3;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.9em;
	}

	.wysiwyg__content :global(.tiptap pre) {
		padding: 16px;
		border-radius: 8px;
		overflow-x: auto;
		background: #252830;
		color: #f7f8f9;
	}

	.wysiwyg__content :global(.tiptap pre code) {
		padding: 0;
		background: transparent;
		color: inherit;
	}

	.wysiwyg__content :global(.tiptap a) {
		color: var(--primary1);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.wysiwyg__content :global(.tiptap p.is-editor-empty:first-child::before) {
		float: left;
		height: 0;
		color: #9da2aa;
		content: '내용을 입력하세요.';
		pointer-events: none;
	}

	@media (max-width: 768px) {
		.wysiwyg__toolbar-group--history {
			margin-left: 0;
		}

		.wysiwyg__content :global(.tiptap) {
			min-height: 360px;
			padding: 16px;
		}
	}
</style>
