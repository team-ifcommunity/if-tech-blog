---
import Template from '@/layouts/Template.astro';
---

<Template title="게시글 관리" description="기존 기술 블로그 게시글을 찾아 수정합니다.">
	<main class="posts-page" id="main">
		<div class="posts-page__inner">
			<header class="posts-page__header">
				<div>
					<p>IF TECH BLOG</p><h1>게시글 관리</h1><span
						>GitHub main 브랜치의 게시글을 불러옵니다.</span
					>
				</div>
				<a href="/admin/write" class="new-post">새 글 작성</a>
			</header>
			<div class="posts-status" id="posts-status" role="status">게시글을 불러오는 중…</div>
			<div class="posts-table" id="posts-table" hidden>
				<table>
					<thead
						><tr
							><th>제목</th><th>카테고리</th><th>작성자</th><th>게시일</th><th
								><span class="sr-only">작업</span></th
							></tr
						></thead
					>
					<tbody id="posts-body"></tbody>
				</table>
			</div>
		</div>
	</main>
	<dialog class="delete-dialog" id="delete-dialog" aria-labelledby="delete-dialog-title">
		<form method="dialog">
			<h2 id="delete-dialog-title">게시글을 삭제할까요?</h2>
			<p class="delete-dialog__target" id="delete-dialog-target"></p>
			<p class="delete-dialog__warning" id="delete-dialog-warning"></p>
			<p class="delete-dialog__status" id="delete-dialog-status" role="status"></p>
			<div class="delete-dialog__actions">
				<button value="cancel" class="delete-dialog__cancel">취소</button>
				<button type="button" class="delete-dialog__confirm" id="delete-dialog-confirm"
					>삭제 확인</button
				>
			</div>
		</form>
	</dialog>
</Template>

<script>
	const status = document.querySelector<HTMLElement>('#posts-status');
	const table = document.querySelector<HTMLElement>('#posts-table');
	const body = document.querySelector<HTMLTableSectionElement>('#posts-body');
	const description = document.querySelector<HTMLElement>('.posts-page__header span');
	const dialog = document.querySelector<HTMLDialogElement>('#delete-dialog');
	const dialogTarget = document.querySelector<HTMLElement>('#delete-dialog-target');
	const dialogWarning = document.querySelector<HTMLElement>('#delete-dialog-warning');
	const dialogStatus = document.querySelector<HTMLElement>('#delete-dialog-status');
	const confirmButton = document.querySelector<HTMLButtonElement>('#delete-dialog-confirm');
	let storageMode: 'local' | 'github' = 'github';
	let pendingDelete: { post: Record<string, unknown>; target: 'local' | 'github' } | null = null;
	void loadPosts();
	confirmButton?.addEventListener('click', () => void deletePost());

	async function loadPosts(message = '', isError = false) {
		if (body) body.replaceChildren();
		if (table) table.hidden = true;
		if (status) {
			status.hidden = false;
			status.textContent = '게시글을 불러오는 중…';
			status.classList.remove('posts-status--error', 'posts-status--success');
		}
		try {
			const response = await fetch('/.netlify/functions/posts-list');
			const result = await response.json().catch(() => ({}));
			if (!response.ok || !result.ok || !Array.isArray(result.posts))
				throw new Error(result.message || '게시글 목록을 불러오지 못했습니다.');
			storageMode = result.storageMode === 'local' ? 'local' : 'github';
			if (description)
				description.textContent =
					storageMode === 'local'
						? '로컬 프로젝트의 게시글입니다. 운영 삭제 버튼은 별도로 표시됩니다.'
						: 'GitHub main 브랜치의 게시글을 불러옵니다.';
			if (!result.posts.length) {
				if (status) {
					status.textContent = message || '등록된 게시글이 없습니다.';
					status.classList.toggle('posts-status--error', isError);
					status.classList.toggle('posts-status--success', Boolean(message) && !isError);
				}
				return;
			}
			for (const post of result.posts) body?.append(createRow(post));
			if (status) {
				status.hidden = !message;
				if (message) status.textContent = message;
				status.classList.toggle('posts-status--error', isError);
				status.classList.toggle('posts-status--success', Boolean(message) && !isError);
			}
			if (table) table.hidden = false;
		} catch (error) {
			if (status) {
				status.textContent =
					error instanceof Error ? error.message : '게시글 목록을 불러오지 못했습니다.';
				status.classList.add('posts-status--error');
			}
		}
	}

	function createRow(post: Record<string, unknown>) {
		const row = document.createElement('tr');
		const titleCell = document.createElement('td');
		const title = document.createElement('strong');
		title.textContent = String(post.title ?? post.file ?? '');
		titleCell.append(title);
		const description = document.createElement('small');
		description.textContent = String(post.description ?? '');
		titleCell.append(description);
		row.append(titleCell, cell(post.category), cell(post.author), cell(post.pubDate));
		const actionCell = document.createElement('td');
		actionCell.className = 'post-actions';
		const link = document.createElement('a');
		link.textContent = '수정';
		link.href = `/admin/edit?file=${encodeURIComponent(String(post.file ?? ''))}`;
		actionCell.append(link);
		if (storageMode === 'local') {
			actionCell.append(deleteButton(post, 'local', '로컬 삭제'));
		}
		actionCell.append(
			deleteButton(post, 'github', storageMode === 'local' ? 'GitHub에서 삭제' : '삭제')
		);
		row.append(actionCell);
		return row;
	}

	function deleteButton(post: Record<string, unknown>, target: 'local' | 'github', label: string) {
		const button = document.createElement('button');
		button.type = 'button';
		button.className = `delete-button delete-button--${target}`;
		button.textContent = label;
		button.addEventListener('click', () => openDeleteDialog(post, target));
		return button;
	}

	function openDeleteDialog(post: Record<string, unknown>, target: 'local' | 'github') {
		if (!dialog) return;
		pendingDelete = { post, target };
		const title = String(post.title ?? post.file ?? '');
		if (dialogTarget) dialogTarget.textContent = `“${title}”`;
		if (dialogWarning)
			dialogWarning.textContent =
				target === 'local'
					? '로컬 MDX 파일과 이 글의 public/post 자산 폴더가 함께 삭제됩니다. GitHub와 Netlify에는 영향을 주지 않습니다.'
					: '운영 GitHub의 MDX와 assets 저장소의 글 자산이 함께 삭제되고 Netlify 재배포가 시작됩니다. 이 작업은 되돌리기 어렵습니다.';
		if (dialogStatus) dialogStatus.textContent = '';
		if (confirmButton) {
			confirmButton.disabled = false;
			confirmButton.textContent = target === 'local' ? '로컬에서 삭제' : 'GitHub에서 삭제';
		}
		dialog.showModal();
	}

	async function deletePost() {
		if (!pendingDelete || !confirmButton) return;
		const { post, target } = pendingDelete;
		const file = String(post.file ?? '');
		confirmButton.disabled = true;
		confirmButton.textContent = '삭제 중…';
		if (dialogStatus) dialogStatus.textContent = '';
		try {
			const response = await fetch('/.netlify/functions/posts-delete', {
				method: 'DELETE',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ target, file, confirmation: file })
			});
			const result = await response.json().catch(() => ({}));
			if (!response.ok || !result.ok) {
				if (result.postDeleted) {
					dialog?.close();
					pendingDelete = null;
					await loadPosts(result.message || '게시글은 삭제했지만 일부 정리에 실패했습니다.', true);
					return;
				}
				throw new Error(result.message || '게시글을 삭제하지 못했습니다.');
			}
			dialog?.close();
			pendingDelete = null;
			const deploymentMessage =
				target === 'github'
					? result.deploymentTriggered
						? ' Netlify 재배포를 시작했습니다.'
						: ' 저장소 연동 배포를 확인해 주세요.'
					: '';
			await loadPosts(`${result.message}${deploymentMessage}`);
		} catch (error) {
			if (dialogStatus)
				dialogStatus.textContent =
					error instanceof Error ? error.message : '게시글을 삭제하지 못했습니다.';
			confirmButton.disabled = false;
			confirmButton.textContent = target === 'local' ? '로컬에서 삭제' : 'GitHub에서 삭제';
		}
	}

	function cell(value: unknown) {
		const element = document.createElement('td');
		element.textContent = String(value ?? '—');
		return element;
	}
</script>

<style is:global>
	.posts-page {
		min-height: calc(100vh - 145px);
		padding: 120px 20px 96px;
		background: var(--bg1);
	}
	.posts-page__inner {
		width: 100%;
		max-width: 1120px;
		margin: 0 auto;
	}
	.posts-page__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 32px;
	}
	.posts-page__header p {
		margin-bottom: 10px;
		color: var(--primary1);
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}
	.posts-page__header h1 {
		color: var(--c333);
		font-size: clamp(2rem, 5vw, 3rem);
		line-height: 1.25;
	}
	.posts-page__header span {
		display: block;
		margin-top: 10px;
		color: var(--c666);
	}
	.posts-page .new-post,
	.posts-page tbody a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 9px;
		font-weight: 650;
	}
	.posts-page .new-post {
		min-width: 120px;
		height: 48px;
		padding: 0 20px;
		background: var(--primary1);
		color: white;
	}
	.posts-status {
		padding: 24px;
		border: 1px solid #e7e7e7;
		border-radius: 12px;
		background: white;
		color: var(--c666);
		text-align: center;
	}
	.posts-status--error {
		border-color: #f0bec4;
		background: #fff5f6;
		color: #a51c2c;
	}
	.posts-status--success {
		border-color: #a8dbc0;
		background: #f1fbf5;
		color: #146b3a;
	}
	.posts-table {
		overflow-x: auto;
		border: 1px solid #e7e7e7;
		border-radius: 14px;
		background: white;
	}
	.posts-table table {
		width: 100%;
		min-width: 760px;
		table-layout: fixed;
		border-collapse: collapse;
	}
	.posts-table th,
	.posts-table td {
		padding: 17px 18px;
		border-bottom: 1px solid #ededed;
		text-align: left;
		vertical-align: middle;
	}
	.posts-table th {
		background: #f7f8f9;
		color: #626871;
		font-size: 0.8125rem;
		white-space: nowrap;
	}
	.posts-table th:first-child {
		width: 52%;
	}
	.posts-table th:nth-child(2) {
		width: 13%;
	}
	.posts-table th:nth-child(3) {
		width: 13%;
	}
	.posts-table th:nth-child(4) {
		width: 14%;
	}
	.posts-table th:last-child {
		width: 80px;
	}
	.posts-table tbody tr {
		transition: background-color 0.18s ease;
	}
	.posts-table tbody tr:hover {
		background: #fafbfc;
	}
	.posts-table tbody tr:last-child td {
		border-bottom: 0;
	}
	.posts-table td {
		color: var(--c555);
		font-size: 0.9375rem;
	}
	.posts-table td:first-child {
		min-width: 300px;
	}
	.posts-table td strong,
	.posts-table td small {
		display: block;
	}
	.posts-table td strong {
		color: var(--c333);
		font-size: 1rem;
		line-height: 1.45;
	}
	.posts-table td small {
		max-width: 520px;
		margin-top: 5px;
		overflow: hidden;
		color: #777d86;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.posts-page tbody a,
	.posts-page tbody button {
		min-width: 64px;
		height: 36px;
		border: 1px solid #d9dce1;
		background: white;
		color: var(--c333);
		font-size: 0.875rem;
		transition:
			border-color 0.18s ease,
			background-color 0.18s ease,
			color 0.18s ease;
	}
	.posts-page tbody a:hover,
	.posts-page tbody button:hover {
		border-color: var(--primary1);
		background: #fff5f6;
		color: var(--primary1);
	}
	.posts-table th:first-child {
		width: 44%;
	}
	.posts-table th:last-child {
		width: 190px;
	}
	.posts-table td.post-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
	}
	.posts-page tbody button {
		padding: 0 10px;
		cursor: pointer;
	}
	.posts-page tbody .delete-button--github {
		border-color: #e7a8ae;
		color: #a51c2c;
	}
	.delete-dialog {
		width: min(92vw, 520px);
		padding: 0;
		border: 0;
		border-radius: 16px;
		box-shadow: 0 24px 70px rgb(0 0 0 / 25%);
	}
	.delete-dialog::backdrop {
		background: rgb(19 22 28 / 58%);
	}
	.delete-dialog form {
		padding: 28px;
	}
	.delete-dialog h2 {
		margin: 0;
		color: var(--c333);
		font-size: 1.4rem;
	}
	.delete-dialog__target {
		margin: 18px 0 10px;
		color: var(--c333);
		font-weight: 700;
		word-break: break-word;
	}
	.delete-dialog__warning {
		margin: 0;
		color: #686e77;
		line-height: 1.65;
	}
	.delete-dialog__status {
		min-height: 1.5em;
		margin: 12px 0 0;
		color: #a51c2c;
		font-size: 0.9rem;
	}
	.delete-dialog__actions {
		display: flex;
		justify-content: flex-end;
		gap: 10px;
		margin-top: 22px;
	}
	.delete-dialog__actions button {
		height: 42px;
		padding: 0 18px;
		border: 0;
		border-radius: 9px;
		font-weight: 700;
		cursor: pointer;
	}
	.delete-dialog__cancel {
		background: #eceef1;
		color: var(--c333);
	}
	.delete-dialog__confirm {
		background: #b32636;
		color: white;
	}
	.delete-dialog__confirm:disabled {
		cursor: wait;
		opacity: 0.65;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	@media (max-width: 768px) {
		.posts-page {
			padding: 94px 16px 64px;
		}
		.posts-page__header {
			align-items: stretch;
			flex-direction: column;
		}
		.new-post {
			align-self: flex-start;
		}
	}
</style>
