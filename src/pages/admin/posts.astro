---
import Template from '@/layouts/Template.astro';
---

<Template title="게시글 관리" description="기존 기술 블로그 게시글을 찾아 수정합니다.">
	<main class="posts-page" id="main">
		<div class="posts-page__inner">
			<header class="posts-page__header">
				<div>
					<p>IF TECH BLOG</p><h1>게시글 관리</h1><span
						>GitHub main 브랜치의 게시글을 불러옵니다.</span
					>
				</div>
				<a href="/admin/write" class="new-post">새 글 작성</a>
			</header>
			<div class="posts-status" id="posts-status" role="status">게시글을 불러오는 중…</div>
			<div class="posts-table" id="posts-table" hidden>
				<table>
					<thead
						><tr
							><th>제목</th><th>카테고리</th><th>작성자</th><th>게시일</th><th
								><span class="sr-only">작업</span></th
							></tr
						></thead
					>
					<tbody id="posts-body"></tbody>
				</table>
			</div>
		</div>
	</main>
</Template>

<script>
	const status = document.querySelector<HTMLElement>('#posts-status');
	const table = document.querySelector<HTMLElement>('#posts-table');
	const body = document.querySelector<HTMLTableSectionElement>('#posts-body');
	void loadPosts();

	async function loadPosts() {
		try {
			const response = await fetch('/.netlify/functions/posts-list');
			const result = await response.json().catch(() => ({}));
			if (!response.ok || !result.ok || !Array.isArray(result.posts))
				throw new Error(result.message || '게시글 목록을 불러오지 못했습니다.');
			if (!result.posts.length) {
				if (status) status.textContent = '등록된 게시글이 없습니다.';
				return;
			}
			for (const post of result.posts) body?.append(createRow(post));
			if (status) status.hidden = true;
			if (table) table.hidden = false;
		} catch (error) {
			if (status) {
				status.textContent =
					error instanceof Error ? error.message : '게시글 목록을 불러오지 못했습니다.';
				status.classList.add('posts-status--error');
			}
		}
	}

	function createRow(post: Record<string, unknown>) {
		const row = document.createElement('tr');
		const titleCell = document.createElement('td');
		const title = document.createElement('strong');
		title.textContent = String(post.title ?? post.file ?? '');
		titleCell.append(title);
		const description = document.createElement('small');
		description.textContent = String(post.description ?? '');
		titleCell.append(description);
		row.append(titleCell, cell(post.category), cell(post.author), cell(post.pubDate));
		const actionCell = document.createElement('td');
		const link = document.createElement('a');
		link.textContent = '수정';
		link.href = `/admin/edit?file=${encodeURIComponent(String(post.file ?? ''))}`;
		actionCell.append(link);
		row.append(actionCell);
		return row;
	}

	function cell(value: unknown) {
		const element = document.createElement('td');
		element.textContent = String(value ?? '—');
		return element;
	}
</script>

<style is:global>
	.posts-page {
		min-height: calc(100vh - 145px);
		padding: 120px 20px 96px;
		background: var(--bg1);
	}
	.posts-page__inner {
		width: 100%;
		max-width: 1120px;
		margin: 0 auto;
	}
	.posts-page__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 32px;
	}
	.posts-page__header p {
		margin-bottom: 10px;
		color: var(--primary1);
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}
	.posts-page__header h1 {
		color: var(--c333);
		font-size: clamp(2rem, 5vw, 3rem);
		line-height: 1.25;
	}
	.posts-page__header span {
		display: block;
		margin-top: 10px;
		color: var(--c666);
	}
	.posts-page .new-post,
	.posts-page tbody a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 9px;
		font-weight: 650;
	}
	.posts-page .new-post {
		min-width: 120px;
		height: 48px;
		padding: 0 20px;
		background: var(--primary1);
		color: white;
	}
	.posts-status {
		padding: 24px;
		border: 1px solid #e7e7e7;
		border-radius: 12px;
		background: white;
		color: var(--c666);
		text-align: center;
	}
	.posts-status--error {
		border-color: #f0bec4;
		background: #fff5f6;
		color: #a51c2c;
	}
	.posts-table {
		overflow-x: auto;
		border: 1px solid #e7e7e7;
		border-radius: 14px;
		background: white;
	}
	.posts-table table {
		width: 100%;
		min-width: 760px;
		table-layout: fixed;
		border-collapse: collapse;
	}
	.posts-table th,
	.posts-table td {
		padding: 17px 18px;
		border-bottom: 1px solid #ededed;
		text-align: left;
		vertical-align: middle;
	}
	.posts-table th {
		background: #f7f8f9;
		color: #626871;
		font-size: 0.8125rem;
		white-space: nowrap;
	}
	.posts-table th:first-child {
		width: 52%;
	}
	.posts-table th:nth-child(2) {
		width: 13%;
	}
	.posts-table th:nth-child(3) {
		width: 13%;
	}
	.posts-table th:nth-child(4) {
		width: 14%;
	}
	.posts-table th:last-child {
		width: 80px;
	}
	.posts-table tbody tr {
		transition: background-color 0.18s ease;
	}
	.posts-table tbody tr:hover {
		background: #fafbfc;
	}
	.posts-table tbody tr:last-child td {
		border-bottom: 0;
	}
	.posts-table td {
		color: var(--c555);
		font-size: 0.9375rem;
	}
	.posts-table td:first-child {
		min-width: 300px;
	}
	.posts-table td strong,
	.posts-table td small {
		display: block;
	}
	.posts-table td strong {
		color: var(--c333);
		font-size: 1rem;
		line-height: 1.45;
	}
	.posts-table td small {
		max-width: 520px;
		margin-top: 5px;
		overflow: hidden;
		color: #777d86;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.posts-page tbody a {
		min-width: 64px;
		height: 36px;
		border: 1px solid #d9dce1;
		background: white;
		color: var(--c333);
		font-size: 0.875rem;
		transition:
			border-color 0.18s ease,
			background-color 0.18s ease,
			color 0.18s ease;
	}
	.posts-page tbody a:hover {
		border-color: var(--primary1);
		background: #fff5f6;
		color: var(--primary1);
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	@media (max-width: 768px) {
		.posts-page {
			padding: 94px 16px 64px;
		}
		.posts-page__header {
			align-items: stretch;
			flex-direction: column;
		}
		.new-post {
			align-self: flex-start;
		}
	}
</style>
