<div class="wysiwyg" data-wysiwyg>
	<div class="wysiwyg__toolbar" role="toolbar" aria-label="본문 서식 도구">
		<div class="wysiwyg__toolbar-group" aria-label="글자 서식">
			<button type="button" data-editor-action="bold" title="굵게 (Ctrl+B)" aria-label="굵게">
				<strong>B</strong>
			</button>
			<button type="button" data-editor-action="italic" title="기울임 (Ctrl+I)" aria-label="기울임">
				<em>I</em>
			</button>
			<button type="button" data-editor-action="code" title="인라인 코드" aria-label="인라인 코드">
				&lt;/&gt;
			</button>
		</div>
		<div class="wysiwyg__toolbar-group" aria-label="제목과 목록">
			<button type="button" data-editor-action="heading2" title="큰 소제목" aria-label="큰 소제목"
				>H2</button
			>
			<button
				type="button"
				data-editor-action="heading3"
				title="작은 소제목"
				aria-label="작은 소제목">H3</button
			>
			<button
				type="button"
				data-editor-action="bulletList"
				title="글머리 기호 목록"
				aria-label="글머리 기호 목록">• 목록</button
			>
			<button
				type="button"
				data-editor-action="orderedList"
				title="번호 목록"
				aria-label="번호 목록">1. 목록</button
			>
		</div>
		<div class="wysiwyg__toolbar-group" aria-label="블록과 링크">
			<button type="button" data-editor-action="blockquote" title="인용문" aria-label="인용문"
				>“ 인용</button
			>
			<button type="button" data-editor-action="codeBlock" title="코드 블록" aria-label="코드 블록"
				>코드 블록</button
			>
			<button type="button" data-editor-action="link" title="링크" aria-label="링크">🔗 링크</button
			>
			<button
				type="button"
				data-editor-action="image"
				title="본문 이미지 추가"
				aria-label="본문 이미지 추가">🖼 이미지</button
			>
		</div>
		<div
			class="wysiwyg__toolbar-group wysiwyg__toolbar-group--history"
			aria-label="실행 취소와 다시 실행"
		>
			<button
				type="button"
				data-editor-action="undo"
				title="실행 취소 (Ctrl+Z)"
				aria-label="실행 취소">↶</button
			>
			<button
				type="button"
				data-editor-action="redo"
				title="다시 실행 (Ctrl+Shift+Z)"
				aria-label="다시 실행">↷</button
			>
		</div>
	</div>
	<input
		type="file"
		data-image-input
		accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp"
		hidden
	/>
	<p class="wysiwyg__status" data-image-status role="status" aria-live="polite" hidden></p>
	<div class="wysiwyg__content" data-editor-content></div>
	<input type="hidden" name="content" data-editor-value />
</div>

<script>
	import { Editor, Node } from '@tiptap/core';
	import Image from '@tiptap/extension-image';
	import Placeholder from '@tiptap/extension-placeholder';
	import StarterKit from '@tiptap/starter-kit';
	import { fileToBase64, validateImageFile } from '@/utils/imageUpload';
	import { serializeTiptapToMarkdown } from '@/utils/tiptapMarkdown.mjs';
	import { parseMarkdownForTiptap } from '@/utils/markdownToTiptap.mjs';

	const RawMdx = Node.create({
		name: 'rawMdx',
		group: 'block',
		atom: true,
		addAttributes() {
			return { value: { default: '' } };
		},
		parseHTML() {
			return [{ tag: 'pre[data-raw-mdx]' }];
		},
		renderHTML({ node }) {
			return ['pre', { 'data-raw-mdx': '', class: 'raw-mdx' }, node.attrs.value];
		}
	});

	const AssetImage = Image.extend({
		addAttributes() {
			return {
				...this.parent?.(),
				assetSrc: {
					default: null,
					parseHTML: (element) => element.getAttribute('data-asset-src'),
					renderHTML: (attributes) =>
						attributes.assetSrc ? { 'data-asset-src': attributes.assetSrc } : {}
				}
			};
		}
	});

	type EditorAction =
		| 'bold'
		| 'italic'
		| 'code'
		| 'heading2'
		| 'heading3'
		| 'bulletList'
		| 'orderedList'
		| 'blockquote'
		| 'codeBlock'
		| 'link'
		| 'image'
		| 'undo'
		| 'redo';

	document.querySelectorAll<HTMLElement>('[data-wysiwyg]').forEach((root) => {
		const content = root.querySelector<HTMLElement>('[data-editor-content]');
		const value = root.querySelector<HTMLInputElement>('[data-editor-value]');
		const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-editor-action]'));
		const imageInput = root.querySelector<HTMLInputElement>('[data-image-input]');
		const imageStatus = root.querySelector<HTMLElement>('[data-image-status]');
		const form = root.closest<HTMLFormElement>('form');
		const categoryInput = form?.elements.namedItem('category') as HTMLInputElement | null;
		const slugInput = form?.elements.namedItem('slug') as HTMLInputElement | null;
		const pubDateInput = form?.elements.namedItem('pubDate') as HTMLInputElement | null;

		if (!content || !value) return;

		const editor = new Editor({
			element: content,
			extensions: [
				StarterKit.configure({
					heading: { levels: [1, 2, 3] },
					link: {
						autolink: true,
						linkOnPaste: true,
						openOnClick: false,
						HTMLAttributes: {
							rel: 'noopener noreferrer',
							target: '_blank'
						}
					},
					strike: false,
					underline: false
				}),
				RawMdx,
				Placeholder.configure({ placeholder: '내용을 입력하세요.' }),
				AssetImage.configure({
					inline: false,
					allowBase64: false
				})
			],
			content: '<p></p>',
			editorProps: {
				attributes: {
					'aria-label': '글 내용',
					class: 'tiptap-editor',
					spellcheck: 'true'
				}
			}
		});

		editor.on('update', ({ editor }) => syncValue(editor));
		editor.on('selectionUpdate', ({ editor }) => updateToolbar(editor));
		editor.on('transaction', ({ editor }) => updateToolbar(editor));
		root.addEventListener('editor:set-content', (event) => {
			const content = (event as CustomEvent<{ content?: string }>).detail?.content ?? '';
			const document = parseMarkdownForTiptap(content);
			applyImagePreviewUrls(document);
			editor.commands.setContent(document);
			syncValue(editor);
		});
		syncValue(editor);
		updateToolbar(editor);

		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				const action = button.dataset.editorAction as EditorAction;

				switch (action) {
					case 'bold':
						editor.chain().focus().toggleBold().run();
						break;
					case 'italic':
						editor.chain().focus().toggleItalic().run();
						break;
					case 'code':
						editor.chain().focus().toggleCode().run();
						break;
					case 'heading2':
						editor.chain().focus().toggleHeading({ level: 2 }).run();
						break;
					case 'heading3':
						editor.chain().focus().toggleHeading({ level: 3 }).run();
						break;
					case 'bulletList':
						editor.chain().focus().toggleBulletList().run();
						break;
					case 'orderedList':
						editor.chain().focus().toggleOrderedList().run();
						break;
					case 'blockquote':
						editor.chain().focus().toggleBlockquote().run();
						break;
					case 'codeBlock':
						editor.chain().focus().toggleCodeBlock().run();
						break;
					case 'link': {
						const currentUrl = editor.getAttributes('link').href ?? '';
						const url = window.prompt('연결할 주소를 입력해 주세요.', currentUrl);
						if (url === null) break;
						if (!url.trim()) editor.chain().focus().extendMarkRange('link').unsetLink().run();
						else editor.chain().focus().extendMarkRange('link').setLink({ href: url.trim() }).run();
						break;
					}
					case 'image':
						openImagePicker();
						break;
					case 'undo':
						editor.chain().focus().undo().run();
						break;
					case 'redo':
						editor.chain().focus().redo().run();
						break;
				}
			});
		});

		imageInput?.addEventListener('change', async () => {
			const file = imageInput.files?.[0];
			imageInput.value = '';
			if (!file) return;

			const validationMessage = validateImageFile(file, '본문 이미지');
			if (validationMessage) {
				setImageStatus(validationMessage, 'error');
				return;
			}

			const category = categoryInput?.value.trim().normalize('NFC') ?? '';
			const slug = slugInput?.value.trim().normalize('NFC').toLowerCase() ?? '';
			if (!category || !/^[\p{L}\p{N}]+(?:-[\p{L}\p{N}]+)*$/u.test(slug)) {
				setImageStatus('카테고리와 올바른 URL 이름을 먼저 입력해 주세요.', 'error');
				return;
			}

			setImageUploading(true);
			setImageStatus('본문 이미지를 업로드하고 있습니다.', 'loading');

			try {
				const contentBase64 = await fileToBase64(file);
				const response = await fetch('/.netlify/functions/image-upload', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						type: 'content',
						fileName: file.name,
						mimeType: file.type,
						contentBase64,
						category,
						slug,
						pubDate: pubDateInput?.value
					})
				});
				const result = await response.json().catch(() => ({}));

				if (!response.ok || !result.ok || !result.imagePath) {
					throw new Error(result.message || '본문 이미지 업로드 중 오류가 발생했습니다.');
				}

				const fileNameWithoutExtension = file.name.replace(/\.[^.]+$/, '').trim();
				const alt = `${fileNameWithoutExtension} 이미지`;
				const assetsBaseUrl = import.meta.env.PUBLIC_ASSETS_BASE_URL;
				const previewSrc =
					result.target !== 'local' && assetsBaseUrl
						? new URL(
								result.imagePath.replace(/^\/post\//, ''),
								`${assetsBaseUrl.replace(/\/+$/, '')}/`
							).toString()
						: result.imagePath;
				editor
					.chain()
					.focus()
					.insertContent({
						type: 'image',
						attrs: {
							src: previewSrc,
							assetSrc: result.imagePath,
							alt
						}
					})
					.run();
				setImageStatus('본문 이미지를 추가했습니다.', 'success');
			} catch (error) {
				setImageStatus(
					error instanceof Error ? error.message : '본문 이미지 업로드 중 오류가 발생했습니다.',
					'error'
				);
			} finally {
				setImageUploading(false);
			}
		});

		root.closest('form')?.addEventListener('reset', () => {
			window.setTimeout(() => {
				editor.commands.clearContent();
				if (imageStatus) imageStatus.hidden = true;
			}, 0);
		});

		function syncValue(currentEditor: Editor) {
			const markdown = currentEditor.isEmpty
				? ''
				: serializeTiptapToMarkdown(currentEditor.state.doc);
			value.value = markdown;
		}

		function applyImagePreviewUrls(node: {
			type?: string;
			attrs?: Record<string, unknown>;
			content?: Array<any>;
		}) {
			if (node.type === 'image' && typeof node.attrs?.assetSrc === 'string') {
				const base = import.meta.env.PUBLIC_ASSETS_BASE_URL;
				if (base && document.documentElement.dataset.cmsStorageMode !== 'local')
					node.attrs.src = new URL(
						node.attrs.assetSrc
							.replace(/^\/+/, '')
							.replace(/^post\//, '')
							.normalize('NFC'),
						`${base.replace(/\/+$/, '')}/`
					).toString();
			}
			node.content?.forEach(applyImagePreviewUrls);
		}

		function openImagePicker() {
			const category = categoryInput?.value.trim() ?? '';
			const slug = slugInput?.value.trim().normalize('NFC').toLowerCase() ?? '';

			if (!category) {
				setImageStatus('본문 이미지를 추가하려면 카테고리를 먼저 입력해 주세요.', 'error');
				categoryInput?.focus();
				return;
			}

			if (!/^[\p{L}\p{N}]+(?:-[\p{L}\p{N}]+)*$/u.test(slug)) {
				setImageStatus('본문 이미지를 추가하려면 올바른 URL 이름을 먼저 입력해 주세요.', 'error');
				slugInput?.focus();
				return;
			}

			imageInput?.click();
		}

		function setImageUploading(isUploading: boolean) {
			const imageButton = buttons.find((button) => button.dataset.editorAction === 'image');
			if (imageButton) imageButton.disabled = isUploading;
		}

		function setImageStatus(message: string, type: 'loading' | 'success' | 'error') {
			if (!imageStatus) return;
			imageStatus.textContent = message;
			imageStatus.dataset.status = type;
			imageStatus.hidden = false;
		}

		function updateToolbar(currentEditor: Editor) {
			const activeActions: Partial<Record<EditorAction, boolean>> = {
				bold: currentEditor.isActive('bold'),
				italic: currentEditor.isActive('italic'),
				code: currentEditor.isActive('code'),
				heading2: currentEditor.isActive('heading', { level: 2 }),
				heading3: currentEditor.isActive('heading', { level: 3 }),
				bulletList: currentEditor.isActive('bulletList'),
				orderedList: currentEditor.isActive('orderedList'),
				blockquote: currentEditor.isActive('blockquote'),
				codeBlock: currentEditor.isActive('codeBlock'),
				link: currentEditor.isActive('link')
			};

			buttons.forEach((button) => {
				const action = button.dataset.editorAction as EditorAction;
				const isActive = activeActions[action] ?? false;
				button.classList.toggle('is-active', isActive);
				if (action !== 'undo' && action !== 'redo')
					button.setAttribute('aria-pressed', String(isActive));
				if (action === 'undo') button.disabled = !currentEditor.can().chain().focus().undo().run();
				if (action === 'redo') button.disabled = !currentEditor.can().chain().focus().redo().run();
			});
		}
	});
</script>

<style>
	.wysiwyg {
		border: 1px solid #d9dce1;
		border-radius: 9px;
		overflow: hidden;
		background: white;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.wysiwyg:focus-within {
		border-color: var(--primary1);
		box-shadow: 0 0 0 3px rgba(229, 45, 66, 0.12);
	}

	.wysiwyg__toolbar {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 9px;
		border-bottom: 1px solid #e7e7e7;
		background: #f7f8f9;
		flex-wrap: wrap;
	}

	.wysiwyg__toolbar-group {
		display: flex;
		gap: 3px;
		padding-right: 6px;
		border-right: 1px solid #dfe1e4;
	}

	.wysiwyg__toolbar-group--history {
		margin-left: auto;
		padding-right: 0;
		border-right: 0;
	}

	.wysiwyg__toolbar button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 34px;
		height: 34px;
		padding: 0 9px;
		border: 1px solid transparent;
		border-radius: 6px;
		background: transparent;
		font: inherit;
		font-size: 0.8125rem;
		font-weight: 650;
		color: #4b5057;
		cursor: pointer;
	}

	.wysiwyg__toolbar button:hover:not(:disabled) {
		border-color: #d9dce1;
		background: white;
	}

	.wysiwyg__toolbar button.is-active {
		border-color: rgba(229, 45, 66, 0.25);
		background: rgba(229, 45, 66, 0.1);
		color: var(--primary1);
	}

	.wysiwyg__toolbar button:focus-visible {
		outline: 2px solid var(--primary1);
		outline-offset: 1px;
	}

	.wysiwyg__toolbar button:disabled {
		opacity: 0.35;
		cursor: default;
	}

	.wysiwyg__content :global(.tiptap) {
		min-height: 420px;
		padding: 20px;
		font-size: 1rem;
		line-height: 1.8;
		color: var(--c333);
	}

	.wysiwyg__content :global(.tiptap:focus) {
		outline: none;
	}

	.wysiwyg__content :global(.tiptap > * + *) {
		margin-top: 0.9em;
	}

	.wysiwyg__content :global(.tiptap h2) {
		font-size: 1.625rem;
		font-weight: 700;
		line-height: 1.4;
	}

	.wysiwyg__content :global(.tiptap h3) {
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.5;
	}

	.wysiwyg__content :global(.tiptap ul),
	.wysiwyg__content :global(.tiptap ol) {
		padding-left: 1.6em;
	}

	.wysiwyg__content :global(.tiptap ul) {
		list-style: disc;
	}

	.wysiwyg__content :global(.tiptap ol) {
		list-style: decimal;
	}

	.wysiwyg__content :global(.tiptap blockquote) {
		padding: 8px 0 8px 16px;
		border-left: 3px solid #d9dce1;
		color: #626871;
	}

	.wysiwyg__content :global(.tiptap code) {
		padding: 2px 5px;
		border-radius: 4px;
		background: #f0f1f3;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.9em;
	}

	.wysiwyg__content :global(.tiptap pre) {
		padding: 16px;
		border-radius: 8px;
		overflow-x: auto;
		background: #252830;
		color: #f7f8f9;
	}

	.wysiwyg__content :global(.tiptap pre code) {
		padding: 0;
		background: transparent;
		color: inherit;
	}

	.wysiwyg__content :global(.tiptap a) {
		color: var(--primary1);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.wysiwyg__content :global(.tiptap img) {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 1.25rem auto;
		border-radius: 8px;
	}

	.wysiwyg__content :global(.tiptap img.ProseMirror-selectednode) {
		outline: 3px solid rgba(229, 45, 66, 0.3);
	}

	.wysiwyg__status {
		padding: 9px 14px;
		border-bottom: 1px solid #e7e7e7;
		background: #f7f8f9;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: #4b5057;
	}

	.wysiwyg__status[data-status='error'] {
		background: #fff5f6;
		color: #a51c2c;
	}

	.wysiwyg__status[data-status='success'] {
		background: #f0faf3;
		color: #176534;
	}

	.wysiwyg__content :global(.tiptap p.is-editor-empty:first-child::before) {
		float: left;
		height: 0;
		color: #9da2aa;
		content: '내용을 입력하세요.';
		pointer-events: none;
	}

	@media (max-width: 768px) {
		.wysiwyg__toolbar-group--history {
			margin-left: 0;
		}

		.wysiwyg__content :global(.tiptap) {
			min-height: 360px;
			padding: 16px;
		}
	}
</style>
