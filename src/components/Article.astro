---
import ArticleContainer from './ArticleContainer.astro';
import Hero from './Hero.astro';
import FormattedDate from './FormattedDate.astro';
import PostReference from './PostReference.astro';
import Image from './Image.astro';
import { hasPostAssetFile, resolvePostFilePath } from '../utils/postAssetPath.js';

const { title, author, pubDate, updatedDate, heroImage, category, headings, ref } = Astro.props;
const hasHeroImage = hasPostAssetFile({ src: heroImage, pubDate, category, type: 'assets' });
const resolvedHeroImage = hasHeroImage
	? resolvePostFilePath({ src: heroImage, pubDate, category, type: 'assets' })
	: null;
---

<ArticleContainer {headings} className={!hasHeroImage ? 'articleNoHero' : ''}>
	{
		hasHeroImage && (
			<Hero slot="hero" hasHeroImage={hasHeroImage}>
				<Image
					className="absolute top-0 left-0 h-full z-[-1] select-none"
					width="1903"
					height="400"
					src={resolvedHeroImage}
					alt={`${title} 글 썸네일`}
				/>
			</Hero>
		)
	}

	<div class="postHeader" slot="post-header">
		<span class="articleCategory">{category}</span>
		<h2 class="articleTitle">{title}</h2>
		<div class="articleMeta">
			{author && <span class="articleAuthor">{author}</span>}
			<div class="articleDate">
				<FormattedDate date={pubDate} />
			</div>
		</div>
	</div>
	<!-- md파일 slot -->
	<slot />
	<!-- // -->
	{ref && <PostReference {ref} slot="ref" />}

	{
		updatedDate && (
			<div class="articleUpdated" slot="updated">
				마지막 업데이트 : <FormattedDate date={updatedDate} />
			</div>
		)
	}
</ArticleContainer>
