---
import Template from '@/layouts/Template.astro';
import TiptapEditor from '@/components/admin/TiptapEditor.astro';

const categories = ['AI', '회고'];
const { mode = 'create' } = Astro.props;
const isEdit = mode === 'edit';
---

<Template
	title={isEdit ? '글 수정' : '글 작성'}
	description={isEdit
		? '사내 기술 블로그의 기존 글을 수정합니다.'
		: '사내 기술 블로그 글을 작성하고 게시합니다.'}
>
	<main class="write-page" id="main">
		<div class="write-page__inner">
			<header class="write-page__header">
				<p class="write-page__eyebrow">IF TECH BLOG</p>
				<h1>{isEdit ? '기존 글 수정' : '새 글 작성'}</h1>
				<p>
					{
						isEdit
							? '기존 파일명은 유지하며 변경한 내용만 저장합니다.'
							: '필요한 내용을 입력한 뒤 게시하면 블로그에 반영됩니다.'
					}
				</p>
			</header>

			<form class="write-form" id="write-form" data-mode={mode}>
				<div class="form-message" id="loading-message" role="status" hidden={!isEdit}>
					글을 불러오는 중…
				</div>
				<div class="write-form__section">
					<div class="write-form__section-heading">
						<span>1</span>
						<div>
							<h2>기본 정보</h2>
							<p>글 목록과 상세 화면에 보여질 정보입니다.</p>
						</div>
					</div>

					<div class="write-form__fields">
						<label class="field field--wide">
							<span class="field__label">제목 <b>필수</b></span>
							<input
								type="text"
								name="title"
								placeholder="예: 우리 팀의 AI 활용기"
								required
								autocomplete="off"
							/>
						</label>

						<label class="field field--wide">
							<span class="field__label">요약 <b>필수</b></span>
							<textarea
								name="description"
								rows="3"
								maxlength="180"
								placeholder="글 목록에 보여질 짧은 소개를 적어주세요."
								required></textarea>
							<span class="field__counter"><span id="description-count">0</span>/180</span>
						</label>

						<label class="field">
							<span class="field__label">카테고리 <b>필수</b></span>
							<input
								type="text"
								name="category"
								list="category-list"
								placeholder="예: AI"
								required
								autocomplete="off"
							/>
							<datalist id="category-list">
								{categories.map((category) => <option value={category} />)}
							</datalist>
							<span class="field__help">기존 카테고리를 선택하거나 새로 입력하세요.</span>
						</label>

						<label class="field">
							<span class="field__label">게시일 <b>필수</b></span>
							<input type="date" name="pubDate" required readonly={!isEdit} />
						</label>

						<label class="field field--checkbox">
							<input type="checkbox" name="isWarning" />
							<span>주의 안내 표시</span>
						</label>

						<label class="field">
							<span class="field__label">작성자 <b>필수</b></span>
							<input
								type="text"
								name="author"
								placeholder="이름을 입력하세요"
								required
								autocomplete="name"
							/>
							<span class="field__help">로그인 기능을 연결하기 전까지 직접 입력합니다.</span>
						</label>

						<label class="field field--wide">
							<span class="field__label">URL 이름 <b>필수</b></span>
							<div class="slug-input">
								<span aria-hidden="true">/posts/</span>
								<input
									type="text"
									name="slug"
									placeholder="ai-use-case"
									pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
									title="영문 소문자, 숫자, 하이픈(-)만 사용해 주세요."
									required
									autocapitalize="none"
									spellcheck="false"
								/>
							</div>
							<span class="field__help">영문 소문자, 숫자, 하이픈(-)만 사용할 수 있습니다.</span>
						</label>
					</div>
				</div>

				<div class="write-form__section">
					<div class="write-form__section-heading">
						<span>2</span>
						<div>
							<h2>썸네일</h2>
							<p>글 목록과 상세 화면에 사용할 대표 이미지를 선택해 주세요.</p>
						</div>
					</div>

					<label class="field field--wide">
						<span class="field__label"
							>썸네일 이미지 <b>{isEdit ? '교체 시에만 선택' : '필수'}</b></span
						>
						<span class="thumbnail-upload">
							<input
								type="file"
								name="thumbnail"
								id="thumbnail-input"
								accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp"
								required={!isEdit}
							/>
							<span class="thumbnail-upload__button">파일 선택</span>
							<span class="thumbnail-upload__name" id="thumbnail-name">선택된 파일 없음</span>
						</span>
						<span class="field__help"
							>{isEdit ? '새 파일을 선택하지 않으면 기존 썸네일을 유지합니다. ' : ''}PNG, JPG, JPEG,
							WEBP · 최대 3MB</span
						>
						<span class="field__error" id="thumbnail-error" hidden></span>
					</label>

					<div class="thumbnail-preview" id="thumbnail-preview" hidden>
						<img id="thumbnail-preview-image" src="" alt="선택한 썸네일 미리보기" />
					</div>
				</div>

				<div class="write-form__section">
					<div class="write-form__section-heading">
						<span>3</span>
						<div>
							<h2>본문</h2>
							<p>도구 모음을 사용해 글을 편하게 작성해 주세요.</p>
						</div>
					</div>

					<div class="field field--wide">
						<span class="field__label">글 내용 <b>필수</b></span>
						<TiptapEditor />
						<span class="field__help"
							>글자 서식, 소제목, 목록, 인용문, 코드, 링크와 본문 이미지를 바로 추가할 수 있습니다.</span
						>
					</div>
				</div>

				<div
					class="form-message"
					id="form-message"
					role="status"
					aria-live="polite"
					tabindex="-1"
					hidden
				>
				</div>

				<div class="write-form__actions">
					<a href={isEdit ? '/admin/posts' : '/'} class="button button--secondary">취소</a>
					<button type="submit" class="button button--primary" id="submit-button">
						<span class="button__label">{isEdit ? '변경 사항 저장' : '글 게시하기'}</span>
						<span class="button__loading" hidden>{isEdit ? '저장 중…' : '게시 중…'}</span>
					</button>
				</div>
			</form>
		</div>
	</main>
</Template>

<script>
	import { fileToBase64, validateImageFile } from '@/utils/imageUpload';

	const form = document.querySelector<HTMLFormElement>('#write-form');
	const mode = form?.dataset.mode === 'edit' ? 'edit' : 'create';
	const submitButton = document.querySelector<HTMLButtonElement>('#submit-button');
	const formMessage = document.querySelector<HTMLDivElement>('#form-message');
	const loadingMessage = document.querySelector<HTMLDivElement>('#loading-message');
	const description = form?.elements.namedItem('description') as HTMLTextAreaElement | null;
	const descriptionCount = document.querySelector<HTMLSpanElement>('#description-count');
	const thumbnailInput = document.querySelector<HTMLInputElement>('#thumbnail-input');
	const thumbnailName = document.querySelector<HTMLSpanElement>('#thumbnail-name');
	const thumbnailError = document.querySelector<HTMLSpanElement>('#thumbnail-error');
	const thumbnailPreview = document.querySelector<HTMLDivElement>('#thumbnail-preview');
	const thumbnailPreviewImage = document.querySelector<HTMLImageElement>(
		'#thumbnail-preview-image'
	);
	let previewUrl = '';
	let currentFile = '';
	let currentSha = '';
	let currentHeroImage = '';

	if (mode === 'edit') void loadPost();
	else setDefaultPubDate();

	function setDefaultPubDate() {
		const pubDateInput = form?.elements.namedItem('pubDate') as HTMLInputElement | null;
		if (pubDateInput) {
			pubDateInput.value = new Intl.DateTimeFormat('en-CA', {
				timeZone: 'Asia/Seoul',
				year: 'numeric',
				month: '2-digit',
				day: '2-digit'
			}).format(new Date());
		}
	}

	description?.addEventListener('input', () => {
		if (descriptionCount) descriptionCount.textContent = String(description.value.length);
	});

	thumbnailInput?.addEventListener('change', () => {
		const file = thumbnailInput.files?.[0];
		clearThumbnailError();
		clearPreview();

		if (!file) {
			if (thumbnailName) thumbnailName.textContent = '선택된 파일 없음';
			return;
		}

		if (thumbnailName) thumbnailName.textContent = `${file.name} · ${formatFileSize(file.size)}`;
		const validationMessage = validateImageFile(file, '썸네일 이미지');

		if (validationMessage) {
			showThumbnailError(validationMessage);
			thumbnailInput.value = '';
			if (thumbnailName) thumbnailName.textContent = '선택된 파일 없음';
			return;
		}

		previewUrl = URL.createObjectURL(file);
		if (thumbnailPreviewImage) thumbnailPreviewImage.src = previewUrl;
		if (thumbnailPreview) thumbnailPreview.hidden = false;
	});

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();

		if (!form.reportValidity() || !submitButton || !formMessage) return;

		const data = new FormData(form);
		const thumbnail = thumbnailInput?.files?.[0];
		if (!thumbnail && mode === 'create') {
			showThumbnailError('썸네일 이미지를 선택해 주세요.');
			showMessage('썸네일 이미지를 선택해 주세요.', 'error');
			return;
		}

		const thumbnailValidationMessage = thumbnail
			? validateImageFile(thumbnail, '썸네일 이미지')
			: '';
		if (thumbnailValidationMessage) {
			showThumbnailError(thumbnailValidationMessage);
			showMessage(thumbnailValidationMessage, 'error');
			return;
		}

		const payload = {
			title: String(data.get('title') ?? '').trim(),
			description: String(data.get('description') ?? '').trim(),
			category: String(data.get('category') ?? '').trim(),
			slug: String(data.get('slug') ?? '')
				.trim()
				.toLowerCase(),
			author: String(data.get('author') ?? '').trim(),
			pubDate: String(data.get('pubDate') ?? '').trim(),
			isWarning: data.get('isWarning') === 'on',
			content: String(data.get('content') ?? '').trim()
		};

		if (!payload.content) {
			showMessage('글 내용을 입력해 주세요.', 'error');
			document.querySelector<HTMLElement>('.tiptap-editor')?.focus();
			return;
		}

		if (
			!payload.title ||
			!payload.description ||
			!payload.category ||
			!payload.slug ||
			!payload.author ||
			!payload.pubDate
		) {
			showMessage('필수 항목을 모두 입력해 주세요.', 'error');
			return;
		}

		setSubmitting(true);
		formMessage.hidden = true;

		try {
			let heroImage = currentHeroImage;
			if (thumbnail) {
				setLoadingMessage('썸네일 업로드 중…');
				const contentBase64 = await fileToBase64(thumbnail);
				const uploadResponse = await fetch('/.netlify/functions/image-upload', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						type: 'thumbnail',
						fileName: thumbnail.name,
						mimeType: thumbnail.type,
						contentBase64,
						category: payload.category,
						slug: payload.slug,
						overwrite: mode === 'edit'
					})
				});
				const uploadResult = await uploadResponse.json().catch(() => ({}));
				if (!uploadResponse.ok || !uploadResult.ok || !uploadResult.imagePath) {
					throw new Error(uploadResult.message || '썸네일 업로드 중 오류가 발생했습니다.');
				}
				heroImage = uploadResult.imagePath;
			}

			setLoadingMessage(mode === 'edit' ? '변경 사항 저장 중…' : '게시글 생성 중…');
			const postResponse = await fetch(
				mode === 'edit' ? '/.netlify/functions/posts-update' : '/.netlify/functions/posts-create',
				{
					method: mode === 'edit' ? 'PUT' : 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ ...payload, heroImage, file: currentFile, sha: currentSha })
				}
			);
			const postResult = await postResponse.json().catch(() => ({}));

			if (!postResponse.ok || !postResult.ok) {
				throw new Error(
					postResult.message ||
						(mode === 'edit'
							? '게시글을 저장하지 못했습니다.'
							: '썸네일은 업로드되었지만 게시글 생성 중 오류가 발생했습니다.')
				);
			}

			showMessage(
				mode === 'edit'
					? '변경 사항을 저장했습니다.'
					: '게시글이 정상적으로 접수되었습니다. 배포가 완료되면 블로그에 표시됩니다.',
				'success'
			);
			if (mode === 'edit') {
				currentSha = postResult.sha ?? currentSha;
				currentHeroImage = heroImage;
				if (thumbnailInput) thumbnailInput.value = '';
				if (thumbnailName) thumbnailName.textContent = '기존 썸네일 유지';
				clearPreview();
				showRemoteThumbnail(currentHeroImage);
			} else {
				form.reset();
				setDefaultPubDate();
				if (descriptionCount) descriptionCount.textContent = '0';
				if (thumbnailName) thumbnailName.textContent = '선택된 파일 없음';
				clearThumbnailError();
				clearPreview();
			}
		} catch (error) {
			const message = error instanceof Error ? error.message : '게시 중 오류가 발생했습니다.';
			showMessage(message, 'error');
		} finally {
			setSubmitting(false);
		}
	});

	async function loadPost() {
		if (!form || !submitButton) return;
		submitButton.disabled = true;
		const file = new URLSearchParams(window.location.search).get('file') ?? '';
		if (!file) {
			showMessage('수정할 글 파일이 지정되지 않았습니다.', 'error');
			return;
		}
		try {
			const response = await fetch(
				`/.netlify/functions/posts-get?file=${encodeURIComponent(file)}`
			);
			const result = await response.json().catch(() => ({}));
			if (!response.ok || !result.ok)
				throw new Error(result.message || '글을 불러오지 못했습니다.');
			currentFile = result.post.file;
			currentSha = result.post.sha;
			currentHeroImage = result.post.heroImage;
			for (const name of ['title', 'description', 'category', 'author', 'slug', 'pubDate']) {
				const input = form.elements.namedItem(name) as
					| HTMLInputElement
					| HTMLTextAreaElement
					| null;
				if (input) input.value = String(result.post[name] ?? '');
			}
			const warning = form.elements.namedItem('isWarning') as HTMLInputElement | null;
			if (warning) warning.checked = Boolean(result.post.isWarning);
			if (descriptionCount) descriptionCount.textContent = String(description?.value.length ?? 0);
			if (thumbnailName) thumbnailName.textContent = '기존 썸네일 유지';
			showRemoteThumbnail(currentHeroImage);
			document
				.querySelector<HTMLElement>('[data-wysiwyg]')
				?.dispatchEvent(
					new CustomEvent('editor:set-content', { detail: { content: result.post.content } })
				);
			if (loadingMessage) loadingMessage.hidden = true;
			submitButton.disabled = false;
		} catch (error) {
			if (loadingMessage) loadingMessage.hidden = true;
			showMessage(error instanceof Error ? error.message : '글을 불러오지 못했습니다.', 'error');
		}
	}

	function showRemoteThumbnail(path: string) {
		if (!path || !thumbnailPreviewImage || !thumbnailPreview) return;
		const base = import.meta.env.PUBLIC_ASSETS_BASE_URL;
		thumbnailPreviewImage.src =
			base && !/^(?:[a-z]+:|\/\/|#)/i.test(path)
				? new URL(
						path.replace(/^\/+/, '').replace(/^post\//, ''),
						`${base.replace(/\/+$/, '')}/`
					).toString()
				: path;
		thumbnailPreview.hidden = false;
	}

	function setSubmitting(isSubmitting: boolean) {
		if (!submitButton) return;
		submitButton.disabled = isSubmitting;
		submitButton.querySelector<HTMLElement>('.button__label')!.hidden = isSubmitting;
		submitButton.querySelector<HTMLElement>('.button__loading')!.hidden = !isSubmitting;
	}

	function setLoadingMessage(message: string) {
		const loadingLabel = submitButton?.querySelector<HTMLElement>('.button__loading');
		if (loadingLabel) loadingLabel.textContent = message;
	}

	function showThumbnailError(message: string) {
		if (!thumbnailError) return;
		thumbnailError.textContent = message;
		thumbnailError.hidden = false;
	}

	function clearThumbnailError() {
		if (!thumbnailError) return;
		thumbnailError.textContent = '';
		thumbnailError.hidden = true;
	}

	function clearPreview() {
		if (previewUrl) URL.revokeObjectURL(previewUrl);
		previewUrl = '';
		if (thumbnailPreviewImage) thumbnailPreviewImage.removeAttribute('src');
		if (thumbnailPreview) thumbnailPreview.hidden = true;
	}

	function formatFileSize(bytes: number) {
		return bytes < 1024 * 1024
			? `${Math.ceil(bytes / 1024)}KB`
			: `${(bytes / 1024 / 1024).toFixed(1)}MB`;
	}

	function showMessage(message: string, type: 'success' | 'error') {
		if (!formMessage) return;
		formMessage.textContent = message;
		formMessage.className = `form-message form-message--${type}`;
		formMessage.hidden = false;
		formMessage.focus();
	}
</script>

<style>
	.write-page {
		min-height: calc(100vh - 145px);
		background: var(--bg1);
		padding: 120px 20px 96px;
	}

	.write-page__inner {
		width: 100%;
		max-width: 920px;
		margin: 0 auto;
	}

	.write-page__header {
		margin-bottom: 36px;
	}

	.write-page__eyebrow {
		margin-bottom: 10px;
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: var(--primary1);
	}

	.write-page__header h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 700;
		line-height: 1.25;
		color: var(--c333);
	}

	.write-page__header > p:last-child {
		margin-top: 12px;
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--c666);
	}

	.write-form {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.write-form__section {
		padding: 36px;
		border: 1px solid #e7e7e7;
		border-radius: 16px;
		background: var(--fff);
		box-shadow: 0 8px 30px rgba(15, 18, 25, 0.04);
	}

	.write-form__section-heading {
		display: flex;
		align-items: flex-start;
		gap: 14px;
		padding-bottom: 24px;
		margin-bottom: 28px;
		border-bottom: 1px solid #ededed;
	}

	.write-form__section-heading > span {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 30px;
		height: 30px;
		border-radius: 50%;
		background: var(--primary1);
		font-size: 0.875rem;
		font-weight: 700;
		color: white;
	}

	.write-form__section-heading h2 {
		font-size: 1.375rem;
		font-weight: 700;
		line-height: 1.3;
		color: var(--c333);
	}

	.write-form__section-heading p {
		margin-top: 6px;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--c666);
	}

	.write-form__fields {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 26px 20px;
	}

	.field {
		position: relative;
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 9px;
	}

	.field--wide {
		grid-column: 1 / -1;
	}

	.field--checkbox {
		align-items: center;
		align-self: end;
		min-height: 50px;
		flex-direction: row;
	}

	.field--checkbox input {
		width: 18px;
		height: 18px;
		accent-color: var(--primary1);
	}

	.field__label {
		font-size: 0.9375rem;
		font-weight: 650;
		color: var(--c333);
	}

	.field__label b {
		margin-left: 3px;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--primary1);
	}

	.field input,
	.field textarea {
		width: 100%;
		border: 1px solid #d9dce1;
		border-radius: 9px;
		background: white;
		font: inherit;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--c333);
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
